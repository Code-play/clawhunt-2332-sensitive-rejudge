# Copy to .env (never commit real values). Every setting is read from the
# environment; the application has no configuration file of its own.

# PostgreSQL 16 - the platform database.
DATABASE_URL=postgresql+psycopg://ipsensitive:ipsensitive_local_dev@127.0.0.1:55432/ipsensitive

# Sensitive-content model gateway (OpenAI-compatible /chat/completions).
# Leave IP_SENSITIVE_MODEL_BASE_URL unset to keep the service in recorded mode.
IP_SENSITIVE_MODEL_BASE_URL=
IP_SENSITIVE_MODEL_API_KEY=
IP_SENSITIVE_MODEL_NAME=
IP_SENSITIVE_MODEL_TIMEOUT_SECONDS=30

# recorded = replay a fixture (tests, demo, offline evaluation)
# http     = call IP_SENSITIVE_MODEL_BASE_URL
IP_SENSITIVE_MODEL_MODE=recorded
IP_SENSITIVE_MODEL_REPLAY=evalset/model_output_v1.json

# fail      = a model failure aborts the run (nothing is written)
# rules_only = keep the rule-stage flags and mark the run degraded
IP_SENSITIVE_ON_MODEL_ERROR=fail
